        <mxCell id="t4a34" value="3.4 — Autorización con Gates&#10;✅ ENTREGADA en Moodle&#10;5 Gates + niveles 1/2/3 + test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="210" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="t4a4" value="4.2 ✅ entregada · 4.3 ⚠️ incompleta · 4.4 ❌ pendiente&#10;lo que SÍ está: CRUD, rutas, middlewares, ownership en index/store&#10;lo que FALTA: FormRequest, JsonResource, Policy, /client/register,&#10;catalogo público, mis-registros/{id}, estado, prefijo /client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
