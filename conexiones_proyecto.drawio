  <diagram id="cadena-auth" name="1. Cadena de autenticación">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t1title" value="🔌 CADENA COMPLETA: de la petición HTTP al modelo de base de datos" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="15" width="1070" height="34" as="geometry" />
        </mxCell>

        <mxCell id="t1req" value="🌐 PETICIÓN HTTP&#10;POST /login  →  devuelve token&#10;GET /algo  →  Header: Authorization: Bearer {token}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="420" y="65" width="360" height="56" as="geometry" />
        </mxCell>

        <mxCell id="t1router" value="routes/api.php  (177 líneas)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="155" width="360" height="36" as="geometry" />
        </mxCell>

        <mxCell id="t1pa" value="Route::prefix('v1/admin')  (línea 25)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="245" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t1pc" value="Route::prefix('v1/cliente')  (línea 150)&#10;⚠️ la 4.4 exige /api/v1/client/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="245" width="320" height="44" as="geometry" />
        </mxCell>

        <mxCell id="t1sa" value="middleware auth:sanctum&#10;valida el token Bearer — sin token → 401" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="335" width="300" height="48" as="geometry" />
        </mxCell>
        <mxCell id="t1sc" value="middleware auth:sanctum&#10;valida el token Bearer — sin token → 401" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="335" width="320" height="48" as="geometry" />
        </mxCell>

        <mxCell id="t1ea" value="EnsureEsAdmin  (app/Http/Middleware)&#10;$request->user() instanceof Administrador&#10;si no → 403 JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="433" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t1ec" value="EnsureEsCliente  (app/Http/Middleware)&#10;$request->user() instanceof CuentaAcceso&#10;si no → 403 JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="433" width="320" height="60" as="geometry" />
        </mxCell>

        <mxCell id="t1ca" value="10 CONTROLADORES admin&#10;Administrador · Rol · Usuario · CuentaAcceso&#10;CategoriaAlimento · Alimento · Donacion&#10;Solicitud · Entrega · AccionImportante" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="543" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="t1cc" value="4 CONTROLADORES cliente&#10;AuthClienteController&#10;ClienteSolicitudController&#10;ClienteDonacionController (+ AlimentoController)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="543" width="320" height="76" as="geometry" />
        </mxCell>

        <mxCell id="t1ma" value="MODELOS Eloquent → MySQL&#10;(con paginate(5))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="669" width="300" height="48" as="geometry" />
        </mxCell>
        <mxCell id="t1mc" value="MODELOS Eloquent → MySQL&#10;filtrados por id_usuario = token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="669" width="320" height="48" as="geometry" />
        </mxCell>

        <mxCell id="t1ja" value="JSON 200" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="767" width="300" height="34" as="geometry" />
        </mxCell>
        <mxCell id="t1jc" value="JSON 200" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="767" width="320" height="34" as="geometry" />
        </mxCell>

        <mxCell id="t1guards" value="🔒 config/auth.php — GUARDS (sesión, NO token)&#10;guard 'admin'     → provider 'administradores'  →  App\Models\Administrador&#10;guard 'cliente'  → provider 'cuentas_acceso'   →  App\Models\CuentaAcceso&#10;guard 'web'       → provider 'users'                  →  App\Models\User  (default)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="845" width="700" height="84" as="geometry" />
        </mxCell>

        <mxCell id="t1tokens" value="🎫 TOKENS creados con createToken()&#10;AuthAdminController::in      → createToken('api-admin')     ⚠️ la 4.3 pide 'admin-token'&#10;AuthClienteController::in   → createToken('api-cliente')   ⚠️ la 4.4 pide 'client-token'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="945" width="700" height="64" as="geometry" />
        </mxCell>

