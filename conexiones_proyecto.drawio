        <mxCell id="t4main" value="main  (ed90991)&#10;TODAS las vistas Blade:&#10;admin/login · dashboard · layouts/app&#10;CRUD de 10 recursos en Blade&#10;(incluye carritos y listas-deseos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="70" width="330" height="110" as="geometry" />
