        <mxCell id="t4a33" value="3.3 — Guardias&#10;✅ ENTREGADA en Moodle&#10;guard admin + @auth/@guest + login admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
