        <mxCell id="t4exp" value="apiv2_experimental  (2918c03)&#10;⭐ LOS GATES de la 3.4:&#10;Gate::before + consultar + crear&#10;editar + eliminar + administrar-administradores&#10;vista administradores/niveles&#10;AutorizacionNivelesTest · PLAN_AUTORIZACION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="210" width="330" height="130" as="geometry" />
        </mxCell>

        <mxCell id="t4san" value="sanctum = apiv2  (9e631b6)  ★ RAMA ACTUAL&#10;API completa: 10 CRUD en /v1/admin/&#10;área cliente en /v1/cliente/&#10;EnsureEsAdmin + EnsureEsCliente&#10;commit 232a581: BORRÓ todas las vistas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="370" width="330" height="120" as="geometry" />
        </mxCell>

        <mxCell id="t4api" value="origin/api  (c986352)&#10;solo limpia la colección Postman&#10;no tiene código del proyecto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="520" width="330" height="80" as="geometry" />
