        <mxCell id="t5san_y3" value="storage/framework/views/7f95ee9c*.php — caché compilada de un dashboard que YA NO existe en disco" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="t5san"><mxGeometry x="15" y="650" width="730" height="32" as="geometry" /></mxCell>
        <mxCell id="t5san_y4" value="Git: 8 archivos modificados (M) + 20 sin trackear (??) SIN COMMIT — ahí vive todo el área cliente" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="t5san"><mxGeometry x="15" y="686" width="730" height="32" as="geometry" /></mxCell>
