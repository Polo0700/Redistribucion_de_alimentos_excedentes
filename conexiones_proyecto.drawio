        <mxCell id="t5san_g8" value="app/Http/Controllers/ClienteDonacionController.php — where id_usuario (ownership ✅)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="t5san"><mxGeometry x="15" y="326" width="730" height="32" as="geometry" /></mxCell>
        <mxCell id="t5san_g9" value="app/Http/Controllers/ — los 10 CRUD: Administrador, Rol, Usuario, CuentaAcceso, Categoria, Alimento, Donacion, Solicitud, Entrega, AccionImportante" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="t5san"><mxGeometry x="15" y="362" width="730" height="32" as="geometry" /></mxCell>
